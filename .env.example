# Local Docker Compose settings. Copy this file to .env and replace any values
# that must differ on your machine. Do not commit .env or real production secrets.

MSSQL_SA_PASSWORD=
# Generate a unique random value with at least 32 characters before starting Compose.
AUTH_SIGNING_KEY=

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Optional external-provider settings. Empty values keep the local demo self-contained.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bam

# Deliberately opt-in bounded provider rehearsals. These are configuration
# targets only; the API also requires an administrator confirmation for every
# outbound call. They never prove recipient receipt or live production use.
PROVIDER_VERIFICATION_ENABLED=false
PROVIDER_VERIFICATION_ALLOW_STRIPE_TEST_READ=false
PROVIDER_VERIFICATION_ALLOW_SMTP=false
PROVIDER_VERIFICATION_ALLOW_FIREBASE=false
PROVIDER_VERIFICATION_MINIMUM_INTERVAL_MINUTES=15
PROVIDER_VERIFICATION_STRIPE_TEST_PAYMENT_INTENT_ID=
PROVIDER_VERIFICATION_SMTP_RECIPIENT=
PROVIDER_VERIFICATION_FIREBASE_INSTALLATION_ID=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

SMTP_HOST=padelclub-mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@padelclub.local
